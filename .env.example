# SEPLE Tender Platform - Environment Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR SECRETS
# DO NOT COMMIT .env TO VERSION CONTROL

# ─── LLM Credentials ─────────────────────────
# Classification routes through the Hermes inference router (agent.auxiliary_client).
# It uses the FIRST working provider it finds: a valid OPENAI_API_KEY, or
# ANTHROPIC_API_KEY, or OPENROUTER_API_KEY. Supply at least ONE that works —
# without it, classification falls back to keyword-only "Needs Human Review".
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-your-anthropic-key-here
OPENROUTER_API_KEY=
LLM_PROVIDER=openai
# Optional: pin a model. Leave blank to let Hermes pick per config.yaml.
LLM_MODEL=

# ─── Database Credentials ────────────────────
DB_PASSWORD=your_secure_postgres_password_here

# ─── Tender Tiger MCP (preferred — pending sales call, +91 99243 32267) ───
TENDER_TIGER_MCP_ENDPOINT=
TENDER_TIGER_MCP_KEY=

# ─── Scraper Credentials (fallback if MCP not available) ─────
TENDER_TIGER_EMAIL=info@seple.in
TENDER_TIGER_PASSWORD=your_new_rotated_password_here

TENDER247_EMAIL=info@seple.in
TENDER247_PASSWORD=your_new_rotated_password_here

# ─── Firecrawl (Complex UI Parsing) ──────────
FIRECRAWL_API_KEY=fc-your-key-here

# ─── Scraper proxy (optional override) ─────────────
# tender247.com drops traffic from cloud IPs. On AWS the scanner derives a
# Zyte proxy from ZYTE_API automatically (Fargate sets AWS_EXECUTION_ENV), so
# this is only needed to force a specific proxy. Leave empty locally and on
# AWS — office connections aren't blocked.
SCRAPER_PROXY=

# ─── Hermes Web Chat (dashboard) ─────────────
# Two-way chat UI at http://localhost:9119. Auth gate is mandatory — set both.
#
# ADMIN account — full access to every dashboard page.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=seple
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=set_a_strong_password_here
#
# SCOPED account (role: tender_user) — same login form, but sees ONLY the
# Tenders board and Chat. Every other page is hidden AND the matching API
# routes return 403, so the restriction holds even outside the browser UI.
# Leave the username blank to disable this account entirely.
HERMES_DASHBOARD_TENDER_USERNAME=Tender
HERMES_DASHBOARD_TENDER_PASSWORD=set_a_strong_password_here
#
# Optional but recommended: without an explicit signing secret the provider
# generates a random one per process, so EVERY user is logged out on each
# container restart. Any 32+ random bytes (base64/hex/text).
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=
#
# Both accounts also accept a precomputed scrypt hash instead of a plaintext
# password, so no secret sits at rest. Generate one with:
#   python -c "from plugins.dashboard_auth.basic import hash_password; print(hash_password('yourpassword'))"
# then set HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH / _TENDER_PASSWORD_HASH
# and remove the plaintext line.

# ─── Slack ───────────────────────────────────
# One-way instant alerts from the pipeline (incoming webhook):
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Two-way chat with the agent needs a Slack BOT (Socket Mode). Create a Slack
# app, add a bot token + app-level token, then run `hermes gateway setup`:
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Email (Daily Digest)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SENDER_EMAIL=your_email@gmail.com
RECIPIENT_EMAILS=team@seple.in,sales@seple.in

# ─── Scheduler Configuration ─────────────────
SCAN_HOUR=6
SCAN_MINUTE=0
TEAMS_WEBHOOK_URL="https://your-teams-webhook-url.example.com"
