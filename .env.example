# ─── SEPLE Tender Platform — Environment Variables ────────
# Copy this to .env and fill in real values
# NEVER commit the real .env file to Git

# ─── Tender Portal Credentials ───────────────────────────
TENDER_TIGER_EMAIL=your-email@company.com
TENDER_TIGER_PASSWORD=your-password-here

TENDER247_EMAIL=your-email@company.com
TENDER247_PASSWORD=your-password-here

# ─── GeM Portal ─────────────────────────────────────────
GEM_API_KEY=your-gem-api-key-here

# ─── Database ────────────────────────────────────────────
DB_PASSWORD=your-secure-db-password
DATABASE_URL=postgresql://postgres:your-secure-db-password@db:5432/tenders

# ─── LLM (OpenRouter) ───────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-key-here

# ─── Slack Notifications ────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── Email Notifications ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@seple.com
EMAIL_TO=team@seple.com,manager@seple.com

# ─── Scheduler ──────────────────────────────────────────
SCAN_HOUR=6
SCAN_MINUTE=0

# ─── Internal API ───────────────────────────────────────
TENDER_API_URL=http://tender-api:8000
