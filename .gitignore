# ─── Secrets (NEVER push these) ───────────────────────────
.env
*.env
!.env.example
secrets/
credentials/
*.pem
*.key

# ─── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/

# ─── Node ────────────────────────────────────────────────
node_modules/

# ─── Hermes local data ───────────────────────────────────
~/.hermes/
.hermes/
.seple/
# Installer/desktop bootstrap stamp (hermes_cli/main.py). Must stay ignored
# so `git stash --include-untracked` during `hermes update` doesn't sweep it
# away and re-trigger a bootstrap (#38529).
.hermes-bootstrap-complete

# ─── Database ────────────────────────────────────────────
*.sqlite
*.db

# ─── Logs ────────────────────────────────────────────────
*.log
logs/

# ─── IDE ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

