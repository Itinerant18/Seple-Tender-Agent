# SEPLE Tender API — FastAPI over the tender database.
# Same playwright base as the scanner: /api/scan/trigger runs the full
# scrape pipeline in-process, so chromium must exist in this image too.
FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.custom.txt .
RUN pip install --no-cache-dir -r requirements.custom.txt

RUN playwright install chromium

COPY . .

ENV DOCKER_ENV=true

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
